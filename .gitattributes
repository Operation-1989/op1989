# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Unity text-based files
*.cs text diff=csharp
*.cginc text
*.shader text
*.hlsl text
*.glsl text
*.compute text
*.mat text
*.prefab text
*.unity text
*.asset text
*.meta text
*.json text
*.xml text
*.txt text
*.md text
*.asmdef text
*.asmref text
*.inputactions text

# Unity YAML Merge Tool configuration (uncomment if using UnityYAMLMerge)
# *.unity merge=unityyamlmerge
# *.prefab merge=unityyamlmerge

# Git LFS for binary asset tracking
*.png filter=lfs diff=lfs merge=lfs -text
